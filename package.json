{
  "name": "barcode-tracker",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "start": "node backend/server.js",
    "dev:backend": "node backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "postinstall": "npm install --prefix frontend"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}
