# OAuth (Google / Microsoft)
GOOGLE_CLIENT_ID= #<your-google-client-id>
GOOGLE_CLIENT_SECRET= #<your-google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

MICROSOFT_CLIENT_ID= #<your-microsoft-client-id>
MICROSOFT_CLIENT_SECRET= #<your-microsoft-client-secret>
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback

# Where the browser returns after OAuth (Vite dev server or production URL)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000

# Frontend → backend (optional)
# Leave VITE_API_BASE empty in dev to use Vite proxy (/api → :3000).
# Set to http://localhost:3000 for direct API calls (requires CORS, enabled in dev).
# VITE_API_BASE=http://localhost:3000
# VITE_API_PROXY_TARGET=http://localhost:3000

# JWT
# Leave blank (or as the placeholder) to auto-generate a strong secret on first run.
# It will be written back here so tokens stay valid across restarts.
# To set manually: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change-me-in-production
